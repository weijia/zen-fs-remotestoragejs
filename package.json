{
  "name": "zen-fs-remotestoragejs",
  "version": "1.2.25",
  "type": "module",
  "description": "RemoteStorage.js backend for zen-fs - distributed file system interface",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test:run"
  },
  "keywords": [
    "zen-fs",
    "filesystem",
    "remotestorage",
    "storage",
    "cloud",
    "distributed",
    "backend",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weijia/zen-fs-remotestoragejs.git"
  },
  "bugs": {
    "url": "https://github.com/weijia/zen-fs-remotestoragejs/issues"
  },
  "homepage": "https://github.com/weijia/zen-fs-remotestoragejs#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@zenfs/core": "^2.3.3",
    "zen-fs-cache": "^1.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.12",
    "express": "^5.1.0",
    "open": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "vitest": {
    "test": {
      "environment": "node",
      "globals": true,
      "include": [
        "tests/**/*.test.ts"
      ],
      "exclude": [
        "node_modules",
        "dist"
      ]
    }
  }
}
